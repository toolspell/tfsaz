# Sinkhole resolver for the live-test bed. Every query is logged.

# Azure-style alias hosts and the shared hostname. TFSaz's hosts-file
# entries must answer these on the client; a query here means a leak.
visualstudio.com dev.azure.com {
    log
    template ANY ANY {
        rcode NXDOMAIN
    }
}

# The mock's hostname: an IPv4 address and no other records. MOCK_ADDRESS
# is the mock's address on the compose network, or for VM clients the
# host address where its ports are published.
devops.mock.test {
    log
    template IN A {
        match ^devops[.]mock[.]test[.]$
        answer "{{ .Name }} 60 IN A {$MOCK_ADDRESS}"
        fallthrough
    }
    template ANY ANY {
        match ^devops[.]mock[.]test[.]$
        rcode NOERROR
        fallthrough
    }
    template ANY ANY {
        rcode NXDOMAIN
    }
}

# Everything else does not exist, so test runs stay offline. NXDOMAIN, not
# REFUSED: Docker's resolver retries a refusal for 10 s before it gives up.
. {
    log
    template ANY ANY {
        rcode NXDOMAIN
    }
}
